//condition 1: M>=60, P>=60, C>=60 and M+P+C>=180
//          2:M and P>=120 or C and P >=110

import java.util.Scanner;

class Problem26{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        System.out.print("Enter the Maths marks: ");
        int m=sc.nextInt();
        System.out.print("Enter the Physics marks: ");
        int p=sc.nextInt();
        System.out.print("Enter the Chemsitry marks: ");
        int c=sc.nextInt();

        if(m>=60 && p>=50 && c>=45){
            if(m+p+c>=180){
                System.out.println("True");
            }
            else{
                System.out.println("False");
            }
        }
        else if(m+p>=120 || c+p>=110){
            System.out.println("True");
        }
        else{
            System.out.println("False");
        }
    }
}
